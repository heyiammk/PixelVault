# Image Privacy Cleaner - Local Environment Configuration
SECRET_KEY=django-insecure-change-this-in-local-production-9f8e7d6c5b4a3f2e1d
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# Storage & Upload Constraints
MAX_UPLOAD_BATCH_SIZE=40
MAX_UPLOAD_FILE_SIZE_MB=40
TEMP_FILE_RETENTION_HOURS=24

# Optional Official External Binary/Integration Paths
# If ExifTool is installed in PATH or specified below, binary lossless metadata editing uses it first.
EXIFTOOL_PATH=exiftool

# Official SynthID Verifier Integration
# Leave blank unless you have configured an official Google Cloud / DeepMind SynthID verification endpoint or local SDK module.
# Never fabricates results: returns "Unable to verify" when no official detector is configured.
SYNTHID_PROVIDER_MODULE=
SYNTHID_API_ENDPOINT=
